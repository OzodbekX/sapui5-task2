<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <Table
                id="bookTable"
                items="{bookModel>/books}"
                mode="MultiSelect"
                class="sapUiResponsiveMargin"
                width="auto"
            >
                <headerToolbar>
                    <OverflowToolbar id="tableHeaderToolbar">
                        <Title
                            id="tableTitle"
                            text="{i18n>tableTitle}"
                        />
                        <ToolbarSpacer id="toolbarSpacer" />
                        <Button
                            id="addRecordButton"
                            text="{i18n>addRecord}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onAddRecord"
                        />
                        <Button
                            id="deleteRecordButton"
                            text="{i18n>deleteRecord}"
                            icon="sap-icon://delete"
                            type="Reject"
                            press=".onDeleteRecord"
                        />
                        <ToolbarSeparator id="toolbarSeparator" />
                        <Input
                            id="titleFilterInput"
                            placeholder="{i18n>filterByTitle}"
                            width="12rem"
                        />
                        <Select
                            id="genreFilterSelect"
                            width="10rem"
                            items="{bookModel>/genres}"
                        >
                            <core:Item
                                id="genreItem"
                                key="{bookModel>key}"
                                text="{bookModel>text}"
                            />
                        </Select>
                        <Button
                            id="filterButton"
                            text="{i18n>filter}"
                            icon="sap-icon://filter"
                            press=".onFilter"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column
                        id="colId"
                        width="5rem"
                    >
                        <Text
                            id="colIdText"
                            text="{i18n>columnId}"
                        />
                    </Column>
                    <Column id="colName">
                        <Text
                            id="colNameText"
                            text="{i18n>columnName}"
                        />
                    </Column>
                    <Column id="colAuthor">
                        <Text
                            id="colAuthorText"
                            text="{i18n>columnAuthor}"
                        />
                    </Column>
                    <Column id="colGenre">
                        <Text
                            id="colGenreText"
                            text="{i18n>columnGenre}"
                        />
                    </Column>
                    <Column id="colReleaseDate">
                        <Text
                            id="colReleaseDateText"
                            text="{i18n>columnReleaseDate}"
                        />
                    </Column>
                    <Column
                        id="colAvailableQuantity"
                        width="10rem"
                        hAlign="Center"
                    >
                        <Text
                            id="colAvailableQuantityText"
                            text="{i18n>columnAvailableQuantity}"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="bookListItem">
                        <cells>
                            <Text
                                id="cellIdText"
                                text="{bookModel>ID}"
                            />
                            <Text
                                id="cellNameText"
                                text="{bookModel>Name}"
                            />
                            <Text
                                id="cellAuthorText"
                                text="{bookModel>Author}"
                            />
                            <Text
                                id="cellGenreText"
                                text="{bookModel>Genre}"
                            />
                            <Text
                                id="cellReleaseDateText"
                                text="{
                                    path:'bookModel>ReleaseDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        style: 'medium'
                                        }}"
                            />
                            <Text
                                id="cellAvailableQuantityText"
                                text="{bookModel>AvailableQuantity}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
