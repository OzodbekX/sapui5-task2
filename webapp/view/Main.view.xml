<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="project1.controller.Main"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <IconTabBar
                id="mainIconTabBar"
                expandable="false"
                selectedKey="json"
                select=".onTabSelect"
            >
                <items>
                    <IconTabFilter
                        id="jsonTab"
                        key="json"
                        text="{i18n>tabJsonModel}"
                        icon="sap-icon://table-view"
                    >
                        <content>
                            <mvc:XMLView
                                id="booksTabView"
                                viewName="project1.view.BooksTab"
                            />
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV2Tab"
                        key="odataV2"
                        text="{i18n>tabODataV2Model}"
                        icon="sap-icon://database"
                    >
                        <content>
                            <mvc:XMLView
                                id="productsV2TabView"
                                viewName="project1.view.ProductsV2Tab"
                            />
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV4Tab"
                        key="odataV4"
                        text="{i18n>tabODataV4Model}"
                        icon="sap-icon://cloud"
                    >
                        <content>
                            <mvc:XMLView
                                id="productsV4TabView"
                                viewName="project1.view.ProductsV4Tab"
                            />
                        </content>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
