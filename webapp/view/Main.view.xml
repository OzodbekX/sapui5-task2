<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <IconTabBar
                id="mainIconTabBar"
                expandable="false"
                selectedKey="json"
            >
                <items>
                    <IconTabFilter
                        id="jsonTab"
                        key="json"
                        text="{i18n>tabJsonModel}"
                        icon="sap-icon://table-view"
                    >
                        <content>
                            <Table
                                id="bookTable"
                                items="{bookModel>/books}"
                                mode="MultiSelect"
                                class="sapUiResponsiveMargin"
                                width="auto"
                            >
                                <headerToolbar>
                                    <OverflowToolbar id="tableHeaderToolbar">
                                        <Title
                                            id="tableTitle"
                                            text="{i18n>tableTitle}"
                                        />
                                        <ToolbarSpacer id="toolbarSpacer" />
                                        <Button
                                            id="addRecordButton"
                                            text="{i18n>addRecord}"
                                            icon="sap-icon://add"
                                            type="Emphasized"
                                            press=".onAddRecord"
                                        />
                                        <Button
                                            id="deleteRecordButton"
                                            text="{i18n>deleteRecord}"
                                            icon="sap-icon://delete"
                                            type="Reject"
                                            press=".onDeleteRecord"
                                        />
                                        <ToolbarSeparator id="toolbarSeparator" />
                                        <Input
                                            id="titleFilterInput"
                                            placeholder="{i18n>filterByTitle}"
                                            width="12rem"
                                        />
                                        <Select
                                            id="genreFilterSelect"
                                            width="10rem"
                                            items="{bookModel>/genres}"
                                        >
                                            <core:Item
                                                id="genreItem"
                                                key="{bookModel>key}"
                                                text="{bookModel>text}"
                                            />
                                        </Select>
                                        <Button
                                            id="filterButton"
                                            text="{i18n>filter}"
                                            icon="sap-icon://filter"
                                            press=".onFilter"
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column
                                        id="colId"
                                        width="5rem"
                                    >
                                        <Text
                                            id="colIdText"
                                            text="{i18n>columnId}"
                                        />
                                    </Column>
                                    <Column id="colName">
                                        <Text
                                            id="colNameText"
                                            text="{i18n>columnName}"
                                        />
                                    </Column>
                                    <Column id="colAuthor">
                                        <Text
                                            id="colAuthorText"
                                            text="{i18n>columnAuthor}"
                                        />
                                    </Column>
                                    <Column id="colGenre">
                                        <Text
                                            id="colGenreText"
                                            text="{i18n>columnGenre}"
                                        />
                                    </Column>
                                    <Column id="colReleaseDate">
                                        <Text
                                            id="colReleaseDateText"
                                            text="{i18n>columnReleaseDate}"
                                        />
                                    </Column>
                                    <Column
                                        id="colAvailableQuantity"
                                        width="10rem"
                                        hAlign="Center"
                                    >
                                        <Text
                                            id="colAvailableQuantityText"
                                            text="{i18n>columnAvailableQuantity}"
                                        />
                                    </Column>
                                    <Column
                                        id="colActions"
                                        width="8rem"
                                        hAlign="Center"
                                    >
                                        <Text
                                            id="colActionsText"
                                            text="{i18n>columnActions}"
                                        />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="bookListItem">
                                        <cells>
                                            <Text
                                                id="cellIdText"
                                                text="{bookModel>ID}"
                                            />
                                            <VBox id="cellNameBox">
                                                <Text
                                                    id="cellNameText"
                                                    text="{bookModel>Name}"
                                                    visible="{=!${bookModel>EditMode}}"
                                                />
                                                <Input
                                                    id="cellNameInput"
                                                    value="{bookModel>Name}"
                                                    visible="{=!!${bookModel>EditMode}}"
                                                />
                                            </VBox>
                                            <Text
                                                id="cellAuthorText"
                                                text="{bookModel>Author}"
                                            />
                                            <Text
                                                id="cellGenreText"
                                                text="{bookModel>Genre}"
                                            />
                                            <Text
                                                id="cellReleaseDateText"
                                                text="{
                                                    parts: ['i18n>publishedYear', 'bookModel>ReleaseDate'],
                                                    formatter: '.formatter.publishedYear'
                                                }"
                                            />
                                            <Text
                                                id="cellAvailableQuantityText"
                                                text="{bookModel>AvailableQuantity}"
                                            />
                                            <HBox
                                                id="cellActionsBox"
                                                justifyContent="Center"
                                            >
                                                <Button
                                                    id="editTitleButton"
                                                    text="{i18n>editTitle}"
                                                    visible="{= !${bookModel>EditMode} }"
                                                    press=".onEditTitle"
                                                />
                                                <Button
                                                    id="saveTitleButton"
                                                    text="{i18n>save}"
                                                    type="Emphasized"
                                                    visible="{= !!${bookModel>EditMode} }"
                                                    press=".onSaveTitle"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV2Tab"
                        key="odataV2"
                        text="{i18n>tabODataV2Model}"
                        icon="sap-icon://database"
                    >
                        <content>
                            <Table
                                id="odataV2Table"
                                items="{odataV2>/Products}"
                                class="sapUiResponsiveMargin"
                                width="auto"
                                growing="true"
                                growingThreshold="20"
                            >
                                <headerToolbar>
                                    <OverflowToolbar id="v2Toolbar">
                                        <Title
                                            id="v2Title"
                                            text="{i18n>productsTableTitle}"
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="v2ColId">
                                        <Text
                                            id="v2ColIdText"
                                            text="{i18n>columnId}"
                                        />
                                    </Column>
                                    <Column id="v2ColName">
                                        <Text
                                            id="v2ColNameText"
                                            text="{i18n>columnProductName}"
                                        />
                                    </Column>
                                    <Column id="v2ColDesc">
                                        <Text
                                            id="v2ColDescText"
                                            text="{i18n>columnDescription}"
                                        />
                                    </Column>
                                    <Column id="v2ColRelDate">
                                        <Text
                                            id="v2ColRelDateText"
                                            text="{i18n>columnReleaseDate}"
                                        />
                                    </Column>
                                    <Column id="v2ColDiscDate">
                                        <Text
                                            id="v2ColDiscDateText"
                                            text="{i18n>columnDiscontinuedDate}"
                                        />
                                    </Column>
                                    <Column id="v2ColRating">
                                        <Text
                                            id="v2ColRatingText"
                                            text="{i18n>columnRating}"
                                        />
                                    </Column>
                                    <Column id="v2ColPrice">
                                        <Text
                                            id="v2ColPriceText"
                                            text="{i18n>columnPrice}"
                                        />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="v2ListItem">
                                        <cells>
                                            <Text
                                                id="v2CellId"
                                                text="{odataV2>ID}"
                                            />
                                            <Text
                                                id="v2CellName"
                                                text="{odataV2>Name}"
                                            />
                                            <Text
                                                id="v2CellDesc"
                                                text="{odataV2>Description}"
                                            />
                                            <Text
                                                id="v2CellRelDate"
                                                text="{
                                                    path: 'odataV2>ReleaseDate',
                                                    type: 'sap.ui.model.type.Date',
                                                    formatOptions: {
                                                        style: 'medium'
                                                    }
                                                }"
                                            />
                                            <Text
                                                id="v2CellDiscDate"
                                                text="{
                                                    path: 'odataV2>DiscontinuedDate',
                                                    type: 'sap.ui.model.type.Date',
                                                    formatOptions: {
                                                        style: 'medium'
                                                    }
                                                }"
                                            />
                                            <Text
                                                id="v2CellRating"
                                                text="{odataV2>Rating}"
                                            />
                                            <Text
                                                id="v2CellPrice"
                                                text="{
                                                    path: 'odataV2>Price',
                                                    type: 'sap.ui.model.type.Float',
                                                    formatOptions: {
                                                        minFractionDigits: 2,
                                                        maxFractionDigits: 2
                                                    }
                                                }"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV4Tab"
                        key="odataV4"
                        text="{i18n>tabODataV4Model}"
                        icon="sap-icon://cloud"
                    >
                        <content>
                            <Table
                                id="odataV4Table"
                                items="{odataV4>/Products}"
                                class="sapUiResponsiveMargin"
                                width="auto"
                                growing="true"
                                growingThreshold="20"
                            >
                                <headerToolbar>
                                    <OverflowToolbar id="v4Toolbar">
                                        <Title
                                            id="v4Title"
                                            text="{i18n>productsTableTitle}"
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="v4ColId">
                                        <Text
                                            id="v4ColIdText"
                                            text="{i18n>columnId}"
                                        />
                                    </Column>
                                    <Column id="v4ColName">
                                        <Text
                                            id="v4ColNameText"
                                            text="{i18n>columnProductName}"
                                        />
                                    </Column>
                                    <Column id="v4ColDesc">
                                        <Text
                                            id="v4ColDescText"
                                            text="{i18n>columnDescription}"
                                        />
                                    </Column>
                                    <Column id="v4ColRelDate">
                                        <Text
                                            id="v4ColRelDateText"
                                            text="{i18n>columnReleaseDate}"
                                        />
                                    </Column>
                                    <Column id="v4ColDiscDate">
                                        <Text
                                            id="v4ColDiscDateText"
                                            text="{i18n>columnDiscontinuedDate}"
                                        />
                                    </Column>
                                    <Column id="v4ColRating">
                                        <Text
                                            id="v4ColRatingText"
                                            text="{i18n>columnRating}"
                                        />
                                    </Column>
                                    <Column id="v4ColPrice">
                                        <Text
                                            id="v4ColPriceText"
                                            text="{i18n>columnPrice}"
                                        />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="v4ListItem">
                                        <cells>
                                            <Text
                                                id="v4CellId"
                                                text="{odataV4>ID}"
                                            />
                                            <Text
                                                id="v4CellName"
                                                text="{odataV4>Name}"
                                            />
                                            <Text
                                                id="v4CellDesc"
                                                text="{odataV4>Description}"
                                            />
                                            <Text
                                                id="v4CellRelDate"
                                                text="{
                                                    path: 'odataV4>ReleaseDate',
                                                    type: 'sap.ui.model.odata.type.DateTimeOffset',
                                                    formatOptions: {
                                                        style: 'medium'
                                                    }
                                                }"
                                            />
                                            <Text
                                                id="v4CellDiscDate"
                                                text="{
                                                    path: 'odataV4>DiscontinuedDate',
                                                    type: 'sap.ui.model.odata.type.DateTimeOffset',
                                                    formatOptions: {
                                                        style: 'medium'
                                                    }
                                                }"
                                            />
                                            <Text
                                                id="v4CellRating"
                                                text="{odataV4>Rating}"
                                            />
                                            <Text
                                                id="v4CellPrice"
                                                text="{
                                                    path: 'odataV4>Price',
                                                    type: 'sap.ui.model.odata.type.Double',
                                                    formatOptions: {
                                                        minFractionDigits: 2,
                                                        maxFractionDigits: 2
                                                    }
                                                }"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
