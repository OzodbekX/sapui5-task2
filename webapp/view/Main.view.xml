<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <IconTabBar
                id="mainIconTabBar"
                expandable="false"
                selectedKey="json"
            >
                <items>
                    <IconTabFilter
                        id="jsonTab"
                        key="json"
                        text="{i18n>tabJsonModel}"
                        icon="sap-icon://table-view"
                    >
                        <content>
                            <core:Fragment
                                fragmentName="project1.view.fragments.BooksTable"
                                type="XML"
                            />
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV2Tab"
                        key="odataV2"
                        text="{i18n>tabODataV2Model}"
                        icon="sap-icon://database"
                    >
                        <content>
                            <core:Fragment
                                fragmentName="project1.view.fragments.ODataV2ProductsTable"
                                type="XML"
                            />
                        </content>
                    </IconTabFilter>
                    <IconTabFilter
                        id="odataV4Tab"
                        key="odataV4"
                        text="{i18n>tabODataV4Model}"
                        icon="sap-icon://cloud"
                    >
                        <content>
                            <core:Fragment
                                fragmentName="project1.view.fragments.ODataV4ProductsTable"
                                type="XML"
                            />
                        </content>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
