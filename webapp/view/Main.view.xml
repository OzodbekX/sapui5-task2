<mvc:View
    controllerName="project1.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <Table
                id="bookTable"
                items="{bookModel>/books}"
                class="sapUiResponsiveMargin"
                width="auto"
            >
                <headerToolbar>
                    <OverflowToolbar id="tableHeaderToolbar">
                        <Title id="tableTitle" text="{i18n>tableTitle}" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="colId"><Text id="colIdText" text="{i18n>columnId}"/></Column>
                    <Column id="colName"><Text id="colNameText" text="{i18n>columnName}"/></Column>
                    <Column id="colAuthor"><Text id="colAuthorText" text="{i18n>columnAuthor}"/></Column>
                    <Column id="colGenre"><Text id="colGenreText" text="{i18n>columnGenre}"/></Column>
                    <Column id="colReleaseDate"><Text id="colReleaseDateText" text="{i18n>columnReleaseDate}"/></Column>
                    <Column id="colAvailableQuantity"><Text id="colAvailableQuantityText" text="{i18n>columnAvailableQuantity}"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="bookListItem">
                        <cells>
                            <Text id="cellIdText" text="{bookModel>ID}" />
                            <Text id="cellNameText" text="{bookModel>Name}" />
                            <Text id="cellAuthorText" text="{bookModel>Author}" />
                            <Text id="cellGenreText" text="{bookModel>Genre}" />
                            <Text id="cellReleaseDateText" text="{bookModel>ReleaseDate}" />
                            <Text id="cellAvailableQuantityText" text="{bookModel>AvailableQuantity}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
